# ---- Exposed to the browser (must be prefixed with VITE_) ----
VITE_APP_NAME=EuroGrades

# Origin of the Laravel API. Leave empty to use same-origin requests
# (the Vite dev proxy locally, or a reverse proxy in production).
# Example for split domains: VITE_API_URL=https://api.example.com
VITE_API_URL=

# ---- Dev server only (never bundled) ----
API_PROXY_TARGET=http://localhost:8000
