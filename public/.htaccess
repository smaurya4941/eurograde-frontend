# Apache config for the built site on Plesk (copied into dist/ by the build).
# Mirrors tools/verify/prod-server.cjs, the server Lighthouse was measured on.

DirectoryIndex index.html
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Existing files and folders are served as they are.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing file-like paths (robots-style files, .well-known/*.json, old asset names…) are real
  # 404s, not the app shell.
  RewriteRule \.[A-Za-z0-9]+$ - [R=404,L]

  # Every other path is a page of the React app.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Build assets have content hashes in their names: cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # The app shell must always be revalidated so new deploys are picked up immediately.
  <If "%{REQUEST_URI} !~ m#^/assets/#">
    Header set Cache-Control "no-cache"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
